# Copy to .env.local for local development, and add the same keys in
# Vercel → your project → Settings → Environment Variables (then redeploy).
# With none of these set the shop runs on sample items, so every deploy renders.

# --- Supabase: items, orders, settings and photos --------------------------
# supabase.com → your project → Project Settings → API.
SUPABASE_URL=
# The "service_role" (secret) key. Server only: never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# --- The Sell app (/sell) -----------------------------------------------------
# Your sign-in password, 8+ characters. Changing it signs every device out.
ADMIN_PASSWORD=
# Optional extra secret mixed into the sign-in cookie (any long random text).
SESSION_SECRET=

# --- Card payments: your own (personal) Stripe account -------------------------
# Stripe → Developers → API keys. Start with sk_test_…, switch to sk_live_… when ready.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → Add destination → <your site>/api/stripe/webhook,
# events: checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired. Paste its signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=

# --- Bitcoin Cash: straight into your own wallet -------------------------------
# Your wallet's xPub (extended PUBLIC key: lists addresses, can't spend). Use a wallet just for this.
# Selene: Settings → Wallet → xPub. Electron Cash: Wallet → Information → Master Public Key.
BCH_XPUB=
# Optional: "Connect wallet" (Cashonize, Paytaca, Zapit). Free project ID at dashboard.reown.com;
# add your site's domain to it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Order emails (optional) ------------------------------------------------------
# resend.com API key. Without your own domain verified there, Resend only sends to your own address.
RESEND_API_KEY=
# Where "you sold something" emails go (defaults to the contact email in Settings).
NOTIFY_EMAIL=
# From address, e.g. "Brian's Garage Sale <sales@yourdomain.com>" (a domain verified in Resend).
NOTIFY_FROM=
# Time zone for hold times in emails.
TZ_DISPLAY=America/Chicago

# --- Site ------------------------------------------------------------------------
# Your custom domain once you have one (Vercel's address is used until then).
NEXT_PUBLIC_SITE_URL=
# Protects the daily clean-up job (vercel.json). Any long random text.
CRON_SECRET=
