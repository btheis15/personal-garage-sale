# The website's settings, for Vercel → personal-garage-sale → Settings → Environment Variables
# (Production), or .env.local for local development. Payment keys are NOT here: they live on the
# Mac mini (server/.env). With SHOP_API_URL blank the site shows sample items.

# --- The Mac mini (server/) ------------------------------------------------------
# Its public address through Caddy + DuckDNS, e.g. https://brian-garage-sale.duckdns.org
# (for local development: http://127.0.0.1:8797).
SHOP_API_URL=
# The three secrets `npm run setup-env` printed on the mini (same values on both sides).
SHOP_API_TOKEN=
SHOP_ADMIN_TOKEN=
REVALIDATE_SECRET=

# --- The Sell app (/sell) ---------------------------------------------------------
# Your sign-in password, 8+ characters. Changing it signs every device out.
ADMIN_PASSWORD=
# Optional extra secret mixed into the sign-in cookie (any long random text).
SESSION_SECRET=

# --- Optional -----------------------------------------------------------------------
# Bitcoin Cash "Connect wallet" (Cashonize, Paytaca, Zapit): a free project ID from
# dashboard.reown.com, with your site's domain added. Without it, buyers pay by QR code.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Your own domain once you have one (Vercel's address is used until then).
NEXT_PUBLIC_SITE_URL=
