# Copy to .env (never commit .env). `npm run setup-env` makes it, with fresh secrets.

# --- Where everything is stored -----------------------------------------------
# The database (garage.db) and photos. Relative paths are inside this folder.
DATA_DIR=data

# --- Port (check it's free first: lsof -nP -iTCP:8797 -sTCP:LISTEN) ---------------
# Om Threads uses 8795/8796; this one is 8797. Caddy forwards your DuckDNS address here.
HOST=127.0.0.1
PORT=8797

# --- The website ------------------------------------------------------------------
# The website's address (Vercel), used to refresh it after each change and in emails.
SITE_URL=https://personal-garage-sale.vercel.app
# This server's public address through Caddy, e.g. https://brian-garage-sale.duckdns.org
# (Stripe sends its notices to <PUBLIC_URL>/stripe/webhook).
PUBLIC_URL=
# Shared with Vercel as SHOP_API_TOKEN: the website reads the catalog and starts checkouts with it.
SHOP_API_TOKEN=
# Shared with Vercel as SHOP_ADMIN_TOKEN: the Sell app adds and changes items with it. Keep it secret.
SHOP_ADMIN_TOKEN=
# Shared with Vercel as REVALIDATE_SECRET: lets this server tell the site to refresh.
REVALIDATE_SECRET=

# --- Card payments: your personal Stripe account (add when ready) ------------------
# Stripe → Developers → API keys. sk_test_… to try it, sk_live_… for real.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → Add destination → <PUBLIC_URL>/stripe/webhook, events:
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired. Its signing secret (whsec_…):
STRIPE_WEBHOOK_SECRET=

# --- Bitcoin Cash (add when ready) ----------------------------------------------------
# Your wallet's xPub (PUBLIC key: lists addresses, can't spend). Use a wallet just for this.
# Selene: Settings → Wallet → xPub. Electron Cash: Wallet → Information → Master Public Key.
BCH_XPUB=

# --- Order emails (optional) ------------------------------------------------------------
# An email account you have, with an app password (Gmail: myaccount.google.com → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# From address (defaults to SMTP_USER) and where "Sold!" emails go (defaults to SMTP_USER).
MAIL_FROM=
NOTIFY_EMAIL=
TIME_ZONE=America/Chicago

# --- Backups ----------------------------------------------------------------------------------
# Nightly copy of the database + photos, e.g. iCloud Drive or an external drive.
BACKUP_DIR=

# --- Dynamic DNS (this project's own DuckDNS subdomain) -----------------------------------
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
